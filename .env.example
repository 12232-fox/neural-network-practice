# Путь к директории с входными данными
DATA_PATH=./data/input

# Выходная директория для подготовленных данных
OUTPUT_DIR=./data/output

# Расширения файлов, которые обрабатывает утилита (через запятую)
EXTENSIONS=.jpg,.png,.csv

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Параметры разбиения и нормализации
TEST_SIZE=0.2
RANDOM_STATE=42
NORMALIZE_METHOD=minmax